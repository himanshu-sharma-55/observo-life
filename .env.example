# Database (MongoDB Atlas)
# Use an SRV connection string from your Atlas cluster.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=observolife

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Optional Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional AI insights (Google Gemini Developer API)
# Get a free API key at https://aistudio.google.com/apikey
# Without this, AI insight buttons are hidden in the app.
GEMINI_API_KEY=
# Comma-separated emails allowed to use AI (feed insights + month recaps).
# If unset, any signed-in user can use AI when GEMINI_API_KEY is set.
# AI_ALLOWED_EMAILS=you@example.com
# Default: gemini-flash-latest (Google's rolling flash alias; works for new API keys).
# Older IDs like gemini-2.5-flash may return 404 for new users.
# GEMINI_MODEL=gemini-flash-latest
